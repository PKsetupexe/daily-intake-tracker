# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.sqlite*
api_token.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/data/

# local caches and logs
/.pnpm-store/
/__pycache__/
*.py[cod]
*.tsbuildinfo
*.log

# desktop packaging outputs (source/config under installer/electron-app stays tracked)
/installer/electron-output*/
/installer/output/
/installer/work*/
/installer/smoke-profile*/
/installer/electron-app/dist/
/installer/electron-app/public/
/.openai/.openai/

# local runtime and generated audit artifacts
/installer/fake-bin/
